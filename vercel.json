{
  "headers": [
    {
      "source": "/website-bestanden/hero-achtergronden/inspiratiebank-header.95a249c4e684.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).cache.:ext(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/website-bestanden/fonts/:name.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/discover?path=sitemap.xml"
    },
    {
      "source": "/activiteiten/",
      "destination": "/api/discover?path=activiteiten"
    },
    {
      "source": "/plaatsen/",
      "destination": "/api/discover?path=plaatsen"
    },
    {
      "source": "/activiteiten/:slug/",
      "destination": "/api/discover?path=activiteiten/:slug"
    },
    {
      "source": "/plaatsen/:slug/",
      "destination": "/api/discover?path=plaatsen/:slug"
    },
    {
      "source": "/activiteiten/:path*",
      "destination": "/api/discover?path=activiteiten/:path*"
    },
    {
      "source": "/plaatsen/:path*",
      "destination": "/api/discover?path=plaatsen/:path*"
    }
  ]
}
